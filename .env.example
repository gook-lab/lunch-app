# 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > JavaScript 키
# 도메인은 프로덕션 1개 + http://localhost:5173 만 등록한다 (엔지니어링 리뷰 D1).
# 와일드카드는 비즈 앱 전용이라 PR 프리뷰 배포는 쓰지 않는다.
VITE_KAKAO_JS_KEY=

# Firebase 웹 앱 설정
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 사무실 좌표 — 도보시간 추정의 기준점. 지어내지 말고 실제 값을 넣는다.
VITE_OFFICE_LAT=
VITE_OFFICE_LNG=
