# 카카오 개발자 콘솔 > 앱 > 플랫폼 키 > JavaScript 키
# 도메인은 프로덕션 1개 + http://localhost:5173 만 등록한다 (엔지니어링 리뷰 D1).
# 와일드카드는 비즈 앱 전용이라 PR 프리뷰 배포는 쓰지 않는다.
VITE_KAKAO_JS_KEY=

# Firebase 웹 앱 설정
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 사무실 좌표 — 도보시간 추정의 기준점. 지어내지 말고 실제 값을 넣는다.
VITE_OFFICE_LAT=
VITE_OFFICE_LNG=

# 링크 미리보기 이미지(og:image)의 앞 주소. index.html 의 %VITE_SITE_URL% 에 들어간다.
# 배포 주소 그대로(끝 / 없이), 예: https://lunch-app-fawn.vercel.app
# 비우면 상대 주소(/og.png)가 되고, 변수 자체가 없으면 %VITE_SITE_URL% 글자가 그대로 남는다.
# 둘 다 슬랙·카카오톡 미리보기 이미지가 안 뜬다.
VITE_SITE_URL=

# 1 이면 Firebase 없이 브라우저 저장(데모)으로 돈다. pnpm dev:demo · build:demo 가 넣어 준다.
VITE_DEMO=

# 1 이면 로컬 Firebase 에뮬레이터(firestore 8080 · auth 9099)에 붙는다. 배포 빌드에서는 비워 둔다.
VITE_FIREBASE_EMULATOR=

# 서버 전용 — 카카오 REST 키. api/photo.js(가게 사진 검색)만 읽는다. VITE_ 를 붙이지 않아 번들에 안 들어간다.
# 배포에서는 Vercel 프로젝트 환경변수에 넣고, 로컬에서는 vercel dev 로 띄울 때만 쓴다(vite 는 api/ 를 돌리지 않는다).
KAKAO_REST_KEY=
