rules_version = '2';

// 로그인 화면이 없는 공개 링크다. 규칙이 유일한 방어선이다 (엔지니어링 리뷰 D2).
//
// 여기서 할 수 없는 것을 먼저 적는다 — 컬렉션 문서 수 상한은 구현할 수 없다.
// Firestore 규칙에는 집계·카운트가 없고 get()/exists() 는 단일 문서에 요청당
// 10회 제한이다 (D9). 막았다고 적지 않는다. 대량 삽입은 사람이 목록에서 보고
// active 로 정리하며, 삭제 금지가 복구를 보장한다.
//
// auth != null 은 "링크를 아는 누구나" 와 동치다. 접근 통제가 아니라
// 기기당 신원을 만들어 필드 검사와 감사를 가능하게 하는 장치다.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 규칙 언어에는 타임존 변환도 zero-pad 문자열 포맷도 없고
    // request.time.year() 는 항상 UTC 다. string(2026)+string(9)+string(16) 은
    // "2026916" 이 되어 "20260916" 과 절대 일치하지 않는다.
    // 그래서 문자열 비교를 포기하고 id 를 정수로 잘라 서버 KST 와 대조한다.
    // 클라이언트 구현은 src/lib/date.ts 의 todayKST(). 구현은 둘, 계약은 하나다.
    function isTodayKST(dayId) {
      let kst = request.time + duration.value(9, 'h');
      return dayId.matches('^[0-9]{8}$')
        && int(dayId[0:4]) == kst.year()
        && int(dayId[4:6]) == kst.month()
        && int(dayId[6:8]) == kst.day();
    }

    function validCoord(lat, lng) {
      return lat is number && lng is number
        && lat > 33.0 && lat < 39.0
        && lng > 124.0 && lng < 132.0;
    }

    function validWalkMin(walkMin) {
      return walkMin is number && walkMin > 0 && walkMin <= 60;
    }

    // 지도에서 꽂은 핀만 채우는 선택 필드다. 기존 문서에는 없으므로
    // "없으면 통과, 있으면 검사" 형태여야 한다. 있는지만 보고 넘기면
    // 아무 문자열이나 들어와 화면이 깨진다.
    function validExtras(data) {
      return (!('price' in data)
               || (data.price is string && data.price in ['~1만', '1~1.5만', '1.5만~']))
        && (!('rating' in data)
               || (data.rating is int && data.rating >= 1 && data.rating <= 5))
        && (!('review' in data)
               || (data.review is string && data.review.size() <= 40))
        && (!('memo' in data)
               || (data.memo is string && data.memo.size() <= 120));
    }

    match /places/{placeId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['name', 'category', 'lat', 'lng', 'walkMin', 'kakaoPlaceId', 'active', 'createdBy',
              'price', 'rating', 'review', 'memo'])
        // hasAll 은 필수 필드만이다. 선택 필드를 여기 넣으면 기존 흐름이 전부 막힌다.
        && request.resource.data.keys().hasAll(
             ['name', 'category', 'lat', 'lng', 'walkMin', 'kakaoPlaceId', 'active', 'createdBy'])
        && validExtras(request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 20
        && request.resource.data.kakaoPlaceId is string
        && request.resource.data.kakaoPlaceId.size() <= 40
        && request.resource.data.active is bool
        && validCoord(request.resource.data.lat, request.resource.data.lng)
        && validWalkMin(request.resource.data.walkMin)
        // 누가 올렸는지 남긴다. 사람을 특정하지 못하지만, 이상한 항목이
        // 한 기기에서 몰려 들어왔는지는 볼 수 있다 — 문서 수 상한을
        // 포기한 뒤로 남은 유일한 단서다.
        && request.resource.data.createdBy == request.auth.uid;

      // 폐업은 active 로 끄고, 오타와 잘못 고른 지점은 고친다 (D8).
      // 수정을 막아두면 좌표를 틀린 가게가 walkMin 탓에 영원히 후보에서
      // 빠지는데 고칠 경로가 없어, 2주차 판정의 근거인 풀 크기가 오염된다.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['name', 'lat', 'lng', 'walkMin', 'category', 'active',
              'price', 'rating', 'review', 'memo', 'removed'])
        // 지우기는 removed 표시다. 문서는 남는다(아래 delete 금지와 같은 이유).
        && (!('removed' in request.resource.data) || request.resource.data.removed is bool)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 20
        && request.resource.data.active is bool
        && validCoord(request.resource.data.lat, request.resource.data.lng)
        && validWalkMin(request.resource.data.walkMin)
        && validExtras(request.resource.data);

      // visits 가 참조한다. 지우지 않는다.
      allow delete: if false;
    }

    match /visits/{dayId} {
      // 최근 14일 범위 쿼리(documentId 기준)가 list 로 나간다.
      allow read: if signedIn();

      // 오늘(KST) 문서만 쓰고 고칠 수 있다. 지난 날짜는 불변이다.
      // decidedAt 을 서버 시각으로 못 박아 클라이언트가 임의 시각을 쓰지 못하게 한다.
      allow create, update: if signedIn()
        && isTodayKST(dayId)
        && request.resource.data.keys().hasOnly(['placeId', 'decidedAt', 'mode'])
        && request.resource.data.keys().hasAll(['placeId', 'decidedAt'])
        // 어떤 게임으로 뽑았는지(선택). 이번 달 기록에만 쓴다.
        && (!('mode' in request.resource.data)
            || (request.resource.data.mode is string && request.resource.data.mode.size() <= 16))
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.placeId.size() <= 64
        && request.resource.data.decidedAt == request.time;

      allow delete: if false;
    }

    // 회사 위치. 문서는 office 하나뿐이다. 링크를 아는 누구나 바꿀 수 있다는 점은
    // places 와 같다 — 대신 좌표 범위와 필드를 못 박고, 삭제는 막는다.
    match /settings/office {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['lat', 'lng', 'updatedAt'])
        && request.resource.data.keys().hasAll(['lat', 'lng', 'updatedAt'])
        && validCoord(request.resource.data.lat, request.resource.data.lng)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // 그 외에는 전부 막는다.
    // 동료 예측 — 게임 전에 "어디 나올까" 를 찍는다. 당첨에는 아무 영향이 없다
    // (당첨은 클라이언트 spin() 의 균등 난수). 기기당 하루 한 표, 자기 표만 쓰고 지운다.
    match /predictions/{dayId}/votes/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && isTodayKST(dayId)
        && request.resource.data.keys().hasOnly(['placeId', 'name', 'at'])
        && request.resource.data.keys().hasAll(['placeId', 'name', 'at'])
        && request.resource.data.placeId is string
        && request.resource.data.placeId.size() > 0
        && request.resource.data.placeId.size() <= 64
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid && isTodayKST(dayId);
    }

    // 별점 — 사람(익명 uid)마다 가게당 한 표. 자기 표만 쓰고 지운다. 평균은 화면이 낸다.
    // 예전엔 가게 문서의 rating 하나를 마지막에 고친 사람이 덮어썼다.
    match /places/{placeId}/ratings/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['score', 'review', 'name', 'at'])
        && request.resource.data.keys().hasAll(['score', 'at'])
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && (!('review' in request.resource.data)
               || (request.resource.data.review is string && request.resource.data.review.size() <= 40))
        && (!('name' in request.resource.data)
               || (request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 12))
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // 점심 팟 — "오늘 면 갈 사람?". 문서 id 가 방장 uid 라 한 사람이 하루 한 팟만 연다.
    // 이름·이메일은 없다. members 는 {uid: 참여 시각} 맵이고, 화면이 uid 로 동물 아바타를 만든다.
    // 숫자(2~10명·메모 40자·HH:MM·게임 후보 30곳)는 src/lib/party.ts 와 같아야 한다.
    match /parties/{dayId}/list/{partyId} {
      function validTime(t) {
        return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }
      // 출발 시각이 아직 안 지났는가(KST). 지난 팟에는 새로 들어갈 수 없다.
      function beforeDeparture(t) {
        let kst = request.time + duration.value(9, 'h');
        return kst.hours() * 60 + kst.minutes() < int(t[0:2]) * 60 + int(t[3:5]);
      }
      // 방장 한 번, 바꿀 수 없다. 원소 형은 규칙이 못 본다(반복문 없음) — 화면이 readGame 으로 거른다.
      function validGame(g) {
        return g is map
          && g.keys().hasOnly(['mode', 'run', 'ids', 'names', 'winnerIndex', 'at'])
          && g.keys().hasAll(['mode', 'run', 'ids', 'names', 'winnerIndex', 'at'])
          && g.mode is string && g.mode.size() > 0 && g.mode.size() <= 16
          && g.run is int && g.run >= 0 && g.run <= 2000000
          && g.ids is list && g.names is list
          && g.ids.size() >= 2 && g.ids.size() <= 30
          && g.names.size() == g.ids.size()
          && g.winnerIndex is int && g.winnerIndex >= 0 && g.winnerIndex < g.ids.size()
          && g.at == request.time;
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && isTodayKST(dayId)
        && partyId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['category', 'time', 'max', 'memo', 'hostUid', 'status', 'members', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['category', 'time', 'max', 'memo', 'hostUid', 'status', 'members', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.category in ['밥', '면', '고기', '분식', '빵·양식']
        && validTime(request.resource.data.time)
        && request.resource.data.max is int
        && request.resource.data.max >= 2
        && request.resource.data.max <= 10
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 40
        && request.resource.data.status == 'open'
        // 처음엔 방장 혼자다.
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == request.time
        && request.resource.data.createdAt == request.time;

      // 고치는 길은 셋뿐이다. 셋 다 오늘 팟만.
      allow update: if signedIn() && isTodayKST(dayId) && (
        // (1) 참여·나가기 — 맵에서 자기 uid 하나만 넣고 뺀다. 방장은 나가지 못한다(취소로 끝낸다).
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members is map
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.auth.uid != resource.data.hostUid
          && (
            // 나가기
            !(request.auth.uid in request.resource.data.members)
            // 참여 — 모집 중이고, 출발 전이고, 자리가 남아 있을 때. 상한은 쓰기 순간의 문서로 잰다.
            || (request.resource.data.members[request.auth.uid] == request.time
                && !(request.auth.uid in resource.data.members)
                && resource.data.status == 'open'
                && beforeDeparture(resource.data.time)
                && request.resource.data.members.size() <= resource.data.max)
          )
        )
        // (2) 마감·다시 모으기 — 방장만.
        || (
          request.auth.uid == resource.data.hostUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['open', 'closed']
        )
        // (3) 게임 결과 — 방장만, 한 번만. 당첨은 방장 기기의 균등 난수 한 번이다.
        || (
          request.auth.uid == resource.data.hostUid
          && !('game' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['game'])
          && validGame(request.resource.data.game)
        )
      );

      // 취소 — 방장만, 오늘 팟만. 지우면 같은 날 다시 열 수 있다.
      allow delete: if signedIn() && isTodayKST(dayId) && request.auth.uid == resource.data.hostUid;
    }

    // 목록·지도가 모든 가게 별점을 한 번에 읽는다(컬렉션 그룹 쿼리).
    match /{path=**}/ratings/{uid} {
      allow read: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
